{
  "name": "painel-equipe-norte-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:web": "node --test tests/*.test.js",
    "preview": "vite preview",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrations:apply && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-excel-file": "9.3.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Banco SQL D1 do Painel Comercial Equipe Norte. O Cloudflare criará este banco automaticamente."
      }
    }
  }
}
